{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AtomicTaskGraph",
  "type": "object",
  "required": ["phases", "tasks"],
  "properties": {
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "depends_on"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "phase", "objective", "dependencies", "files_likely_affected", "test_first", "implementation", "verification", "acceptance_criteria", "non_goals"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "phase": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "files_likely_affected": {"type": "array"},
          "test_first": {"type": "string"},
          "tdd_exception": {"type": "string"},
          "implementation": {"type": "string", "minLength": 1},
          "verification": {"type": "array", "minItems": 1},
          "acceptance_criteria": {"type": "array", "minItems": 1},
          "non_goals": {"type": "array"}
        }
      }
    }
  }
}
